<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- This is likely the main activity theme -->
    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar"> <!-- Consider MaterialComponents -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- <item name="android:background">@null</item> This is fine, or remove if not needed -->

        <!-- Added these items for edge-to-edge display -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Optional: Control status bar icon colors (true for light background, false for dark) -->
        <!-- For the current dark theme, false is likely correct -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Optional: Control navigation bar icon colors (true for light background, false for dark) -->
        <!-- For current dark theme, false is likely correct -->
        <item name="android:windowLightNavigationBar">false</item> <!-- Requires API 27+ -->
    </style>

    <!-- Splash Screen Theme (Keep as is, this is for the launch screen) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- You might also need postSplashScreenTheme for seamless transition -->
        <!-- <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item> -->
    </style>
</resources>